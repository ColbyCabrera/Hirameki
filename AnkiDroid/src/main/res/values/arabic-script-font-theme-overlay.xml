<resources>
    <!-- applied by Themes.setTheme over the base theme when the ui language uses arabic script (com.ichi2.themes.ArabicScriptFont) -->
    <style name="ThemeOverlay.Hirameki.ArabicScriptFont" parent="">
        <item name="android:fontFamily">@font/vazirmatn_family</item>
        <!-- the theme font above only reaches text a widget does not restyle itself. a toolbar title, a collapsing
             settings title, a list row and a button each apply a text appearance to their own textview, and
             material's typescale styles name sans-serif in them, which wins. so the typescale attributes those
             appearances come from are swapped here as well -->
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Hirameki.ArabicScript.TitleLarge</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Hirameki.ArabicScript.HeadlineSmall</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Hirameki.ArabicScript.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Hirameki.ArabicScript.BodyLarge</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Hirameki.ArabicScript.LabelLarge</item>
        <!-- bodyMedium is the message of every material dialog (m3_comp_dialog_supporting_text_type) and the second
             line of a list row (android:textAppearanceListItemSecondary); labelMedium is a bottom navigation label
             (m3_comp_nav_bar_item_*_label_text_font). without these two an arabic dialog showed a vazirmatn title
             over a naskh message -->
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Hirameki.ArabicScript.BodyMedium</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Hirameki.ArabicScript.LabelMedium</item>
        <!-- and the family for appearances set in code, out of reach of the attributes above: the deck options
             toolbar title (TextAppearance.Anki.PageToolbar.Expressive, applied by pages/DeckOptions.kt) -->
        <item name="uiFontFamily">@font/vazirmatn_family</item>
        <!-- snackbars name their font in their own styles (SnackbarTextViewStyle, SnackbarButtonStyle in styles.xml),
             which a theme-level font does not reach -->
        <item name="snackbarTextViewStyle">@style/SnackbarTextViewStyle.ArabicScript</item>
        <item name="snackbarButtonStyle">@style/SnackbarButtonStyle.ArabicScript</item>
    </style>
    <!-- each keeps its material size, weight and spacing and changes only the font. both spellings of the
         attribute: appcompat's textview reads the app-namespace one first and android's only as a fallback -->
    <style name="TextAppearance.Hirameki.ArabicScript.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/vazirmatn_family</item>
        <item name="android:fontFamily">@font/vazirmatn_family</item>
    </style>
    <style name="TextAppearance.Hirameki.ArabicScript.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/vazirmatn_family</item>
        <item name="android:fontFamily">@font/vazirmatn_family</item>
    </style>
    <style name="TextAppearance.Hirameki.ArabicScript.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/vazirmatn_family</item>
        <item name="android:fontFamily">@font/vazirmatn_family</item>
    </style>
    <style name="TextAppearance.Hirameki.ArabicScript.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/vazirmatn_family</item>
        <item name="android:fontFamily">@font/vazirmatn_family</item>
    </style>
    <style name="TextAppearance.Hirameki.ArabicScript.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/vazirmatn_family</item>
        <item name="android:fontFamily">@font/vazirmatn_family</item>
    </style>
    <style name="TextAppearance.Hirameki.ArabicScript.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/vazirmatn_family</item>
        <item name="android:fontFamily">@font/vazirmatn_family</item>
    </style>
    <style name="TextAppearance.Hirameki.ArabicScript.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/vazirmatn_family</item>
        <item name="android:fontFamily">@font/vazirmatn_family</item>
    </style>
    <style name="SnackbarTextViewStyle.ArabicScript">
        <item name="android:fontFamily">@font/vazirmatn_family</item>
    </style>
    <style name="SnackbarButtonStyle.ArabicScript">
        <item name="android:fontFamily">@font/vazirmatn_family</item>
    </style>
</resources>
