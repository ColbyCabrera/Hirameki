<?xml version="1.0" encoding="utf-8"?>
<!-- vazirmatn for views in an arabic-script ui, see com.ichi2.themes.ArabicScriptFont. one variable file pinned
     to the weights views ask for, so medium and bold are the font's own instances rather than faked.
     its licence ships at assets/fonts/vazirmatn/OFL.txt, not next to the font: res/font takes font files only,
     and the ofl asks for the licence to travel with the font, so it stays inside the apk -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/vazirmatn" android:fontStyle="normal" android:fontWeight="400" android:fontVariationSettings="'wght' 400" />
    <font android:font="@font/vazirmatn" android:fontStyle="normal" android:fontWeight="500" android:fontVariationSettings="'wght' 500" />
    <font android:font="@font/vazirmatn" android:fontStyle="normal" android:fontWeight="700" android:fontVariationSettings="'wght' 700" />
</font-family>
