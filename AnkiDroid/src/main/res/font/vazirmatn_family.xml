<?xml version="1.0" encoding="utf-8"?>
<!-- Vazirmatn for Views in an Arabic-script UI (see com.ichi2.themes.ArabicScriptFont). One variable font file
     pinned to the weights Views ask for, so medium and bold are the font's own instances rather than synthesized.
     Its license is located at assets/fonts/vazirmatn/OFL.txt because res/font only accepts font files. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/vazirmatn" android:fontStyle="normal" android:fontWeight="400" android:fontVariationSettings="'wght' 400" />
    <font android:font="@font/vazirmatn" android:fontStyle="normal" android:fontWeight="500" android:fontVariationSettings="'wght' 500" />
    <font android:font="@font/vazirmatn" android:fontStyle="normal" android:fontWeight="700" android:fontVariationSettings="'wght' 700" />
</font-family>
