<LinearLayout style="@style/Animation.Design.BottomSheetDialog"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="16dp"
    android:orientation="vertical">

    <LinearLayout
        android:padding="16dp"
        android:id="@+id/occlusion_action_camera"
        android:layout_width="match_parent"
        android:minHeight="?attr/listPreferredItemHeight"
        android:background="?attr/selectableItemBackground"
        android:layout_height="wrap_content" >

        <ImageView
            android:layout_width="wrap_content"
            app:srcCompat="@drawable/ic_camera"
            android:layout_marginEnd="24dp"
            android:layout_marginStart="8dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/occlusion_action_camera_label"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="@string/multimedia_editor_image_field_editing_photo"
            app:iconPadding="12dp"
            app:icon="@drawable/ic_camera" />
    </LinearLayout>

    <LinearLayout
        android:padding="16dp"

        android:id="@+id/occlusion_action_gallery"
        android:layout_width="match_parent"
        android:minHeight="?attr/listPreferredItemHeight"
        android:background="?attr/selectableItemBackground"
        android:layout_height="wrap_content" >

        <ImageView
            android:layout_width="wrap_content"
            app:srcCompat="@drawable/ic_gallery"
            android:layout_marginEnd="24dp"
            android:layout_marginStart="8dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/occlusion_action_gallery_label"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="@string/multimedia_editor_image_field_editing_galery" />
    </LinearLayout>

</LinearLayout>